# Copy to .env and fill in. Never commit .env.

# Claude API (highlight selection, scoring, hooks, captions, re-edit rewrites)
ANTHROPIC_API_KEY=

# Upload-Post (posting/scheduling). Get it from the Upload-Post dashboard.
UPLOAD_POST_API_KEY=

# Only needed if transcription.backend is "openai" in config.yaml
OPENAI_API_KEY=

# Optional: where daily summaries / alerts go. Leave blank to only write them to logs\.
# A Discord or Slack-compatible incoming webhook URL.
ALERT_WEBHOOK_URL=
